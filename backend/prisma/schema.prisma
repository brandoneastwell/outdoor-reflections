generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

model UserAccount {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String?
  created_At  DateTime     @default(now())
  reflections Reflection[]
  refreshTokens RefreshToken[]
  accounts    AuthProvider[]
  settings    AccountSettings?

  @@map("user_account")
}

model AccountSettings {
  userId         Int         @id
  cloudAiEnabled Boolean     @default(false)
  user           UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_settings")
}

model AuthProvider {
  id         String @id @default(uuid())
  provider   String
  providerId String
  userId     Int
  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerId])
}

model Reflection {
  id           String      @id @db.Uuid
  userId       Int
  revision     String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payload      Json?
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  lastSyncedAt DateTime    @default(now()) @db.Timestamptz(6)
  lastEditedAt DateTime
  deletedAt    DateTime?   @db.Timestamptz(6)
  user         UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reflection")
}

model RefreshToken {
  id          String       @id @db.Uuid
  userId      Int
  tokenHash   String?
  device      String?
  createdAt   DateTime
  user        UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, device])
  @@map("refresh_token")
}
