generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum SuggestionType {
  sentence_starter
}

model UserAccount {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String?
  created_At  DateTime     @default(now())
  reflections Reflection[]
  refreshTokens RefreshToken[]
  accounts    AuthProvider[]

  @@map("user_account")
}

model AuthProvider {
  id         String @id @default(uuid())
  provider   String
  providerId String
  userId     Int
  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerId])
}

model Reflection {
  id           String      @id @db.Uuid
  userId       Int
  title        String      @db.VarChar(50)
  content      String[]
  date         DateTime    @default(now()) @db.Date
  drawingPaths Json        @default("[]")
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  lastSyncedAt DateTime    @default(now()) @db.Timestamptz(6)
  lastEditedAt DateTime
  user         UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions  ReflectionSuggestion[]

  @@map("reflection")
}

model ReflectionSuggestion {
  id             String             @id @default(uuid())
  reflectionId   String             @db.Uuid
  type           SuggestionType
  text           String
  createdAt      DateTime           @default(now())
  reflection     Reflection  @relation(fields: [reflectionId], references: [id], onDelete: Cascade)

  @@index([reflectionId])
}

model RefreshToken {
  id          String       @id @db.Uuid
  userId      Int
  tokenHash   String?
  device      String?
  createdAt   DateTime
  user        UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, device])
  @@map("refresh_token")
}
